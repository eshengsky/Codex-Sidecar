{
  "name": "codex-sidecar",
  "version": "0.1.0",
  "private": true,
  "description": "A macOS companion panel for monitoring Codex Desktop threads, usage, prompts, and local metadata.",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:renderer": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "codex:schema": "codex app-server generate-ts --out src/codex-schema"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@iconify-json/lucide": "^1.2.114",
    "@iconify-json/proicons": "^1.2.19",
    "@iconify/vue": "^5.0.1",
    "@nuxt/ui": "^4.8.2",
    "tailwindcss": "^4.3.1",
    "vue": "^3.5.38",
    "vue-i18n": "^11.4.6",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@vitejs/plugin-vue": "^6.0.7",
    "electron": "^42.4.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vue-tsc": "^3.3.5"
  },
  "packageManager": "pnpm@11.3.0"
}
